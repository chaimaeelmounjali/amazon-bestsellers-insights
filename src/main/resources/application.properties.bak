# ========================================
# APPLICATION.PROPERTIES
# Configuration pour Amazon Best Sellers
# ========================================

# ========== APPLICATION NAME ==========
spring.application.name=AmazonBestSeller


# ========== DATABASE CONFIGURATION ==========
spring.datasource.url=jdbc:mysql://localhost:3306/amazon_bestsellers?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=123456789
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ========== JPA/HIBERNATE CONFIGURATION ==========
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.jdbc.batch_size=20
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true
spring.jpa.open-in-view=false

# ========== LOGGING CONFIGURATION ==========
logging.level.root=INFO
logging.level.com.example.amazonbestseller=DEBUG
logging.level.org.springframework.web=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ========== JACKSON CONFIGURATION ==========
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.time-zone=UTC
spring.jackson.date-format=yyyy-MM-dd'T'HH:mm:ss

# ========== MULTIPART FILE UPLOAD ==========
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ========== SECURITY CONFIGURATION ==========
spring.security.user.name=admin
spring.security.user.password=$2a$10$slYQmyNdGzTn7ZLBXBChFOC9f6kFjAqPhccnP6DxlWXx2lPk1C3G6

# ========== EMAIL CONFIGURATION ==========
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-app-specific-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# ========== JWT CONFIGURATION ==========
jwt.secret=your-256-bit-secret-make-sure-it's-very-secure-and-kept-secret
jwt.expiration=86400000

# ========== FILE UPLOAD CONFIGURATION ==========
file.upload.dir=C:/uploads/
file.upload.images=C:/uploads/images/
file.upload.max-size=10MB

# ========== CSV CONFIGURATION ==========
# IMPORTANT: Utiliser le chemin absolu sans "classpath:"
csv.file.path=C:/Users/RPC/IdeaProjects/AmazonBestSeller/src/main/resources/uploads/Amazon_Best_Seller_2021_June 2.csv

# ========== APPLICATION CUSTOM PROPERTIES ==========
# Activer/désactiver le chargement automatique du CSV au démarrage
app.load-csv-on-startup=true

# Stock alerts configuration
app.stock.seuil-min-default=10
app.stock.seuil-max-default=1000
app.stock.alerte-critique=5

# Commission configuration
app.commission.default=10
app.commission.transaction-fees=2

# Statistiques configuration
app.statistiques.periode-historique=90
app.statistiques.periode-prediction=30

# Image configuration
app.images.base-url=http://localhost:${server.port}${server.servlet.context-path}/uploads/
app.images.default-placeholder=/images/placeholder.jpg

# ========== SERVER CONFIGURATION ==========
server.port=8080

# ========== STATIC RESOURCES CONFIGURATION ==========
# Configuration pour servir les fichiers statiques
spring.web.resources.static-locations=file:${file.upload.dir},classpath:/static/,classpath:/public/,classpath:/resources/,classpath:/META-INF/resources/
spring.mvc.static-path-pattern=/uploads/**

# Cache des ressources statiques (1 an)
spring.web.resources.cache.period=31536000
spring.web.resources.cache.cachecontrol.max-age=31536000
spring.web.resources.cache.cachecontrol.must-revalidate=true

# ========== CORS CONFIGURATION ==========
cors.allowed-origins=http://localhost:3000,http://localhost:4200
cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
cors.allowed-headers=*
cors.allow-credentials=true

# ========== ACTUATOR ENDPOINTS ==========
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always
